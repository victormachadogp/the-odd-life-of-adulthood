{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Comic",
  "type": "object",
  "required": ["title", "date", "excerpt", "pages", "tags"],
  "properties": {
    "title": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["comic", "art"],
      "default": "comic",
      "description": "'comic' = sequential panels; 'art' = standalone illustration"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 (YYYY-MM-DD)"
    },
    "excerpt": { "type": "string" },
    "pages": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Ordered list of image paths relative to this folder. First item is the cover/thumbnail."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "readingTime": { "type": "string" }
  },
  "additionalProperties": false
}